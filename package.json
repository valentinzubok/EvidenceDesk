{
  "name": "evidence-desk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sdk:build": "npm run build --prefix packages/evidence-desk-sdk",
    "mobile:start": "npm run start --prefix apps/mobile"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/nextjs": "^9.0.0",
    "@storybook/react": "^9.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^14.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "storybook": "^9.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
